# EstateAI Backend Environment Variables
# Copy this file to .env and fill in the values

# ── Residential Proxy (Proxynet / IPRoyal / Webshare / Smartproxy vb.) ─────────
# Format: http://kullanici:sifre@sunucu:port
#
# Proxynet (şu anki sağlayıcı):
#   RESIDENTIAL_PROXY_URL=http://proxynet-yf5tjb9b:786gLuDaF9ehz8@gate-res.proxynet.io:8000
#
# VDS'te aktif etmek için:
#   export RESIDENTIAL_PROXY_URL="http://proxynet-yf5tjb9b:786gLuDaF9ehz8@gate-res.proxynet.io:8000"
#
# NOT: Proxy sadece DrissionPage tarayıcı tüneli üzerinden çalışır.
#      requests() ile test etmeye çalışırsan başarısız görünebilir — bu normaldir.
#      Sistem testi geçemese bile proxy'yi DrissionPage'e geçer (active=True).
RESIDENTIAL_PROXY_URL=http://username:password@proxy.example.com:port
